#!/usr/bin/env bash
# TravelWell.World — pre-commit.
#
# Two jobs, a few seconds total:
#   · no commit may leave a generated file out of step with its source
#   · no commit may leave the data outside its own gates
#
# The second job was added 2026-08-28, after the research library named the
# failure class from inside their own fix: "fourteen checkers existed and nine
# had never been invoked once." We carried the same class — validate:providers
# and check:advisory-text were referenced by NOTHING but themselves, so they
# were checks only in the sense that a fire extinguisher behind a locked door
# is safety equipment. Every deterministic, network-free gate now runs here.
#
# Deliberately NOT here, and why: check:brand and a11y read the BUILT site, so
# they belong to the build-and-verify discipline (they'd need a dist/ that a
# source commit doesn't imply); check:advisory-links needs outbound network,
# and a blocked run exits nonzero precisely so it can't hand out a tick from
# an environment that can't verify. Excluding a gate is a stated decision, not
# a forgotten one — that's the whole lesson.
#
# Enabled automatically by `npm install` (the "prepare" script points
# core.hooksPath at this directory). To set it up by hand:
#
#   git config core.hooksPath .githooks
#
# It lives in the repo rather than .git/hooks so it survives a fresh clone and
# applies to everyone — a hook only one machine has is a hook that catches
# nothing.
#
# Skipping it is `git commit --no-verify`. That exists for a reason and is
# sometimes right; it is also how a check quietly stops being a check, so if you
# find yourself reaching for it twice, the check is wrong and should be fixed
# rather than dodged.
set -euo pipefail

# No node_modules (fresh clone, CI shell) — say so and let the commit through
# rather than blocking work on a toolchain that isn't installed yet.
if [ ! -x node_modules/.bin/esbuild ]; then
  echo "pre-commit: skipping the generated-file check — node_modules isn't installed."
  exit 0
fi

npm run --silent check:generated

# The data gates — each is sub-second, deterministic, and network-free. Run
# with output captured and shown only on failure, so a passing commit stays
# quiet and a failing one says exactly which gate refused and why.
for gate in validate:ingest validate:si validate:providers check:advisory-text; do
  if ! out=$(npm run --silent "$gate" 2>&1); then
    echo "pre-commit: $gate refused this commit:"
    echo "$out" | tail -20
    exit 1
  fi
done

{
  "name": "travelwell-world",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "TravelWell.World \u2014 a Travel Operating System. React + TypeScript + Tailwind + Supabase + Claude.",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:sitemap && tsc -b && vite build && npm run gen:heads",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "a11y": "node scripts/a11y-audit.mjs",
    "validate:ingest": "esbuild scripts/validate-destinations.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/val.mjs && node scratchpad/val.mjs",
    "gen:sitemap": "esbuild scripts/gen-sitemap.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/sitemap.mjs && node scratchpad/sitemap.mjs",
    "validate:si": "esbuild scripts/validate-si.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/valsi.mjs && node scratchpad/valsi.mjs",
    "gen:taglines": "esbuild scripts/gen-tagline-list.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/tag.mjs && node scratchpad/tag.mjs",
    "check:advisory-links": "esbuild scripts/check-advisory-links.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/links.mjs && node scratchpad/links.mjs",
    "gen:advisory-links": "esbuild scripts/gen-advisory-link-list.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/genlinks.mjs && node scratchpad/genlinks.mjs",
    "gen:advisory-payload": "esbuild scripts/gen-advisory-payload.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/genpayload.mjs && node scratchpad/genpayload.mjs",
    "gen:ground-truth": "esbuild scripts/gen-ground-truth.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/gengt.mjs && node scratchpad/gengt.mjs",
    "gen:heads": "esbuild scripts/gen-static-heads.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=scratchpad/heads.mjs && node scratchpad/heads.mjs",
    "gen:catalog": "esbuild scripts/gen-catalog-seed.ts --bundle --platform=node --format=esm --outfile=scratchpad/gen.mjs && node scratchpad/gen.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "livekit-client": "^2.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
